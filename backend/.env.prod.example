# ============================================================
# 线上（服务器）配置：复制为 .env.prod 后按需修改
#   cp backend/.env.prod.example backend/.env.prod
# ============================================================

# 运行模式：prod（泛域名 + 反向代理）
DEPLOY_MODE=prod
DEBUG=false

HOST=0.0.0.0
PORT=8000

# ---- 域名与路由 ----
# BASE_DOMAIN 只填「应用泛域名去掉 * 后的部分」，不要带控制台前缀。
# 例：控制台 app.jinyuttsrz.top + 应用 *.beta.jinyuttsrz.top
#     → BASE_DOMAIN=beta.jinyuttsrz.top
#
# 务必不要写成带层级的前缀（如 app.beta.jinyuttsrz.top）：
#   应用域名会拼成 xxx.app.beta.jinyuttsrz.top，而泛解析 *.beta.jinyuttsrz.top
#   只匹配一层，覆盖不到二级子域，所有应用都会打不开。
BASE_DOMAIN=beta.jinyuttsrz.top
USE_HTTPS=false
ENABLE_NGINX=true
# 平台内层 nginx 的监听端口。
#   宿主 80 空闲（无宝塔/无其他 nginx）→ 填 80
#   宿主机已有 nginx 占用 80（如宝塔）→ 填 8080，由外层 nginx 反代进来
# 注意：改这里时，deploy/console.conf 里的 listen 要同步改。
NGINX_LISTEN_PORT=8080
# 用户实际访问的端口（外层反代监听的口），决定控制台展示的应用访问地址。
NGINX_PUBLIC_PORT=80
NGINX_CONF_DIR=/etc/nginx/conf.d

# ---- HTTPS（先跑通 HTTP，之后再启用）----
# 应用用了泛域名，证书必须是「泛域名证书」*.appbeta.jinyuttsrz.top，
# 且只能用 DNS-01 方式签发（certbot 的 cloudflare / dnspod 等 DNS 插件）：
#   certbot certonly --dns-cloudflare -d appbeta.jinyuttsrz.top \
#       -d '*.appbeta.jinyuttsrz.top'
# USE_HTTPS=true
# SSL_CERT_PATH=/etc/letsencrypt/live/appbeta.jinyuttsrz.top/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/appbeta.jinyuttsrz.top/privkey.pem

# ---- 数据持久化（容器内路径，对应 compose 的挂载）----
DB_URL=sqlite:////data/paas.db
WORKSPACE_DIR=/data/workspace
# 内置示例代码包目录（对应 compose 里 ./demo:/demo 的容器内路径）
DEMO_DIR=/demo

# ---- Docker ----
DOCKER_HOST=unix:///var/run/docker.sock
DEFAULT_MEM_LIMIT=256m
DEFAULT_CPU_QUOTA=1.0

# ---- M3 镜像构建 ----
IMAGE_PREFIX=paas
MAX_UPLOAD_MB=100
BUILD_TIMEOUT=900
GIT_CLONE_TIMEOUT=300
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

PORT_RANGE_START=20000
PORT_RANGE_END=29999

# ---- AI 只读分析助手（OpenAI 兼容接口）----
# Key 只放服务器环境变量，切勿写入前端或提交到仓库
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 留空使用 app/prompts/ai_system.md；也可填写绝对路径或相对 backend 的路径
AI_PROMPT_FILE=
AI_TIMEOUT=60
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.2
AI_HISTORY_LIMIT=8
AI_RATE_LIMIT_PER_MIN=10
AI_CONTEXT_APPS=30

# ---- 登录与鉴权 ----
ENABLE_AUTH=true
AUTH_ALLOW_REGISTER=true
AUTH_ENABLE_CAPTCHA=true
# 首次启动自动创建的管理员，务必修改默认口令！
AUTH_BOOTSTRAP_ADMIN=true
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=请改成强密码
