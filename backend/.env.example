# 本地开发模式配置（复制为 .env 后使用）
DEPLOY_MODE=local
DEBUG=true

HOST=0.0.0.0
PORT=8000

# M4 本地也开 Nginx，用 {app}.localhost 域名验证动态路由；线上填 BASE_DOMAIN + 证书
BASE_DOMAIN=
USE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
ENABLE_NGINX=true
NGINX_LISTEN_PORT=80

# 本地用 SQLite
DB_URL=sqlite:///./paas.db

DOCKER_HOST=unix:///var/run/docker.sock
DEFAULT_MEM_LIMIT=256m
DEFAULT_CPU_QUOTA=1.0

# M3 镜像构建
WORKSPACE_DIR=./workspace
IMAGE_PREFIX=paas
MAX_UPLOAD_MB=100
BUILD_TIMEOUT=900
GIT_CLONE_TIMEOUT=300
# 构建期依赖源（本地网络受限时用国内镜像；线上留空走官方源）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

PORT_RANGE_START=20000
PORT_RANGE_END=29999
