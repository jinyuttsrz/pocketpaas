# 本地开发模式配置（复制为 .env 后使用）
DEPLOY_MODE=local
DEBUG=true

HOST=0.0.0.0
PORT=8000

# M4 本地也开 Nginx，用 {app}.localhost 域名验证动态路由；线上填 BASE_DOMAIN + 证书
BASE_DOMAIN=
USE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
ENABLE_NGINX=true
NGINX_LISTEN_PORT=80

# 本地用 SQLite
DB_URL=sqlite:///./paas.db

DOCKER_HOST=unix:///var/run/docker.sock
DEFAULT_MEM_LIMIT=256m
DEFAULT_CPU_QUOTA=1.0

# M3 镜像构建
WORKSPACE_DIR=./workspace
IMAGE_PREFIX=paas
MAX_UPLOAD_MB=100
BUILD_TIMEOUT=900
GIT_CLONE_TIMEOUT=300
# 构建期依赖源（本地网络受限时用国内镜像；线上留空走官方源）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

PORT_RANGE_START=20000
PORT_RANGE_END=29999

# ---- AI 只读分析助手（OpenAI 兼容接口）----
# 示例：AI_BASE_URL=https://api.deepseek.com/v1 / AI_MODEL=deepseek-chat
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 留空使用 app/prompts/ai_system.md；也可填写绝对路径或相对 backend 的路径
AI_PROMPT_FILE=
AI_TIMEOUT=60
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.2
AI_HISTORY_LIMIT=8
AI_RATE_LIMIT_PER_MIN=10
AI_CONTEXT_APPS=30
